APP_NAME='TopwebCRM'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_CURRENCY=BRL

TOPWEB_CHAT_PROVIDER=openwa
TOPWEB_CHAT_BASE_URL=http://openwa:2785
TOPWEB_CHAT_PUBLIC_URL=
TOPWEB_CHAT_CONNECT_TIMEOUT=10
TOPWEB_CHAT_REQUEST_TIMEOUT=30
TOPWEB_CHAT_HISTORY_BATCH_SIZE=20
TOPWEB_CHAT_SEND_MAX_ATTEMPTS=5
TOPWEB_CHAT_ATTENDANCE_INACTIVITY_MINUTES=1440
TOPWEB_CHAT_ATTENDANCE_CLOSE_BATCH_SIZE=100

# OpenWA specific
TOPWEB_CHAT_OPENWA_SESSION=topweb
TOPWEB_CHAT_OPENWA_AUTO_START=true
TOPWEB_CHAT_WEBHOOK_RETRY_COUNT=3
TOPWEB_CHAT_WEBHOOK_TIMEOUT=10
TOPWEB_CHAT_MEDIA_INLINE_MAX_BYTES=1048576
TOPWEB_CHAT_MEDIA_MAX_BYTES=52428800
TOPWEB_CHAT_MEDIA_RETENTION_DAYS=365
TOPWEB_CHAT_MEDIA_CLEANUP_SCHEDULE=daily
TOPWEB_CHAT_MEDIA_DISK=private
REDIS_QUEUE_RETRY_AFTER=180

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=topwebcrm
DB_USERNAME=topwebcrm
DB_PASSWORD=topwebcrm
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail configuration
# For local development with Mailhog (included in docker-compose):
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@topweb.com.br
MAIL_FROM_NAME="TopwebCRM"

