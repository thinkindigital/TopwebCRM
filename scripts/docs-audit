#!/usr/bin/env bash
set -u

DOCS_PATH="${DOCS_PATH:-.}"
ROOT_PATH="${ROOT_PATH:-..}"
DOCS_RE=${DOCS_PATH//./\\.}

failures=0
fail() { printf 'FAIL [%s] %s\n' "$1" "$2"; failures=$((failures + 1)); }
pass() { printf 'ok   [%s] %s\n' "$1" "$2"; }

active_docs() {
  grep -rl '^status: active$' "$DOCS_PATH" --include='*.md' 2>/dev/null \
    | grep -v "^$DOCS_PATH/archive/" | sort
}

# DOC001: every explicit Markdown path in active docs resolves.
missing=""
while IFS= read -r file; do
  dir=${file%/*}
  while IFS= read -r ref; do
    [ -e "$dir/$ref" ] || [ -e "$ref" ] || missing="$missing $file->$ref"
  done < <(grep -hoE '(\.\./)+[-A-Za-z0-9_][-/A-Za-z0-9_]*\.md|\./[-A-Za-z0-9_][-/A-Za-z0-9_]*\.md' "$file" | sort -u)
done < <(active_docs)

while IFS= read -r file; do
  dir=${file%/*}
  while IFS= read -r link; do
    target=${link#']('}; target=${target%')'}; target=${target%%#*}
    case "$target" in http://*|https://*) continue ;; $DOCS_PATH/*) resolved=$target ;; *) resolved=$dir/$target ;; esac
    [ -e "$resolved" ] || missing="$missing $file->$target"
  done < <(grep -hoE '\]\([^)]+\.md(#[^)]*)?\)' "$file" 2>/dev/null | grep -v '^\.\./' | grep -v '^[a-z]/' || true)
done < <(active_docs)

for ref in AGENTS.md CONTEXT.md ORCHESTRATOR-ROADMAP.md; do
  grep -qE "(\.\./)?$ref" "$DOCS_PATH/README.md" && [ -e "$ROOT_PATH/$ref" ] || missing="$missing $ref"
done
[ -z "$missing" ] && pass DOC001 'canonical paths resolve' || fail DOC001 "missing:$missing"

# DOC002: every active canonical document has required metadata.
bad=""
while IFS= read -r file; do
  for key in doc_id type status authority scope last_verified_commit update_triggers related; do
    grep -q "^${key}:" "$file" || bad="$bad $file:$key"
  done
done < <(active_docs)
[ -z "$bad" ] && pass DOC002 'active docs have metadata' || fail DOC002 "metadata:$bad"

# DOC003: every archive document declares its replacement and warning.
bad=""
while IFS= read -r file; do
  grep -qiE '^STATUS: ARCHIVED|^status: archived$' "$file" || bad="$bad $file:status"
  grep -qiE '^SUPERSEDED BY:|^superseded_by:' "$file" || bad="$bad $file:replacement"
  grep -qi '^DO NOT USE FOR IMPLEMENTATION' "$file" || bad="$bad $file:warning"
done < <(find "$DOCS_PATH/archive" -type f -name '*.md' 2>/dev/null | sort)
[ -z "$bad" ] && pass DOC003 'archives are marked' || fail DOC003 "archive:$bad"

# DOC004: roadmap has stable IDs, GitHub links, and existing program source.
duplicates=$(grep -oE '\[E[0-9]{2}\]' "$ROOT_PATH/ORCHESTRATOR-ROADMAP.md" | sort | uniq -d)
if [ -z "$duplicates" ] \
  && ! grep '^### ' "$ROOT_PATH/ORCHESTRATOR-ROADMAP.md" | grep -vqE 'https://github.com/[^/]+/[^/]+/issues/[0-9]+' \
  && [ -f "$DOCS_PATH/programs/e14-commercial-workspace/MASTER.md" ]; then
  pass DOC004 'roadmap links and sources resolve'
else fail DOC004 'roadmap ID, link, or source invalid'; fi

# DOC005: every active program has a coverage ledger.
bad=""
for dir in "$DOCS_PATH/programs"/*; do
  [ -d "$dir" ] || continue
  [ -f "$dir/COVERAGE.md" ] || bad="$bad $dir/COVERAGE.md"
done
[ -z "$bad" ] && pass DOC005 'active programs have coverage' || fail DOC005 "missing:$bad"

# DOC006: active playbooks implement the complete operational contract.
bad=""
while IFS= read -r file; do
  for heading in Purpose Scope Authority Inputs 'Required reading' Skills 'Execution phases' 'Current status' Completed Blocked Next 'Stop conditions' 'Definition of Done' 'Update triggers'; do
    grep -qiE "^## ${heading}$" "$file" || bad="$bad $file:$heading"
  done
done < <(grep -rl '^type: playbook$' "$DOCS_PATH" --include='*.md' 2>/dev/null | grep -v "^$DOCS_PATH/archive/" | sort)
[ -z "$bad" ] && pass DOC006 'playbooks expose CURRENT/NEXT/BLOCKED' || fail DOC006 "state:$bad"

# DOC007: explicit ADR links resolve.
missing=""
refs=$(while IFS= read -r file; do
  grep -hoE "$DOCS_RE/architecture/adr/[-A-Za-z0-9_][-/A-Za-z0-9_]*\.md" "$file"
done < <(active_docs) | sort -u)
while IFS= read -r ref; do
  [ -z "$ref" ] && continue
  [ -e "$ref" ] || missing="$missing $ref"
done <<< "$refs"
[ -z "$missing" ] && pass DOC007 'ADR links resolve' || fail DOC007 "missing:$missing"

# DOC008: mandatory canonical sources cannot be ignored or untracked.
ignored=""
while IFS= read -r file; do
  git -C "$DOCS_PATH" check-ignore -q "$file" 2>/dev/null && ignored="$ignored $file:ignored"
  git -C "$DOCS_PATH" ls-files --error-unmatch "$file" >/dev/null 2>&1 || ignored="$ignored $file:untracked"
done < <(active_docs)
[ -z "$ignored" ] && pass DOC008 'canonical sources are tracked' || fail DOC008 "source:$ignored"

# DOC009: doc_id values are unique.
duplicates=$(while IFS= read -r file; do grep -hE '^doc_id:' "$file"; done < <(active_docs) | sort | uniq -d)
[ -z "$duplicates" ] && pass DOC009 'doc_id values are unique' || fail DOC009 "duplicates:$duplicates"

# DOC010: verification commits exist, are ancestors, and are not stale.
bad=""
max_age=${DOC_MAX_COMMIT_AGE:-100}
while IFS= read -r line; do
  file=${line%%:*}
  sha=${line##*:}
  sha=$(printf '%s' "$sha" | tr -d ' ')
  if ! git -C "$DOCS_PATH" cat-file -e "${sha}^{commit}" 2>/dev/null; then bad="$bad $file:$sha"; continue; fi
  git -C "$DOCS_PATH" merge-base --is-ancestor "$sha" HEAD 2>/dev/null || { bad="$bad $file:not-ancestor"; continue; }
  age=$(git -C "$DOCS_PATH" rev-list --count "$sha"..HEAD)
  [ "$age" -le "$max_age" ] || bad="$bad $file:${age}-commits-old"
done < <(grep -rH '^last_verified_commit:' "$DOCS_PATH" --include='*.md' 2>/dev/null | grep -v "^$DOCS_PATH/archive/")
[ -z "$bad" ] && pass DOC010 'verification commits resolve' || fail DOC010 "stale:$bad"

# DOC011: no done program can retain blocked/not-started capability.
bad=""
while IFS= read -r dir; do
  program=$(basename "$dir")
  grep -qiE "\[E[0-9]+\].*${program}|${program}" "$ROOT_PATH/ORCHESTRATOR-ROADMAP.md" || continue
  if grep -qiE "${program}.*- .?done|\[E14\].*- .?done" "$ROOT_PATH/ORCHESTRATOR-ROADMAP.md" \
    && grep -qiE 'BLOCKED|NOT_STARTED|NOT STARTED' "$dir/COVERAGE.md"; then bad="$bad $program"; fi
done < <(find "$DOCS_PATH/programs" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
[ -z "$bad" ] && pass DOC011 'done programs have no blockers' || fail DOC011 "programs:$bad"

# DOC012: README is the index and links every canonical area.
bad=""
for path in "DOCUMENTATION-GOVERNANCE.md" "product/" "policies/" "architecture/" "modules/topweb-chat/README.md" "operations/" "programs/e14-commercial-workspace/README.md"; do
  grep -qE "(\[|\(|\`|\s|^)($path|\\./$path)(\]|\s|\)|\`|$)" "$DOCS_PATH/README.md" || bad="$bad $path"
done
[ -z "$bad" ] && pass DOC012 'README indexes canonical areas' || fail DOC012 "index:$bad"

printf '%s\n' '----'
if [ "$failures" -eq 0 ]; then printf 'docs-audit: PASS (12/12)\n'; exit 0; fi
printf 'docs-audit: FAIL (%s finding(s))\n' "$failures"
[ "${1:-}" = '--strict' ] && exit 1
exit 0